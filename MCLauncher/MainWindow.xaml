<Window x:Class="MCLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MCLauncher.WPFDataTypes"
        mc:Ignorable="d"
        Title="Minecraft版本管理器" Height="450" Width="800">
    <!-- <Window.Background>  
        <ImageBrush ImageSource="pack://application:,,,/MCLauncher;component/background.png" TileMode="Tile" />  
    </Window.Background> -->
    <Window.Resources>
        <CollectionViewSource
            x:Key="versionListViewRelease"
            IsLiveFilteringRequested="True"
        />
        <CollectionViewSource
            x:Key="versionListViewBeta"
            IsLiveFilteringRequested="True"
        />
        <CollectionViewSource
            x:Key="versionListViewPreview"
            IsLiveFilteringRequested="True"
        />
        <CollectionViewSource
            x:Key="versionListViewImported"
            IsLiveFilteringRequested="True"
        />

        <!--
        <Style x:Key="BorderOnlyButtonStyle" TargetType="{x:Type Button}">  
        <Setter Property="Background" Value="Transparent"/>  
        <Setter Property="BorderThickness" Value="1"/>  
